# ========================================
# JJTEXTILES BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ========================================

# MongoDB Configuration
# Option 1: New Database (Recommended)
MONGODB_URI=mongodb://jjtextiles:YOUR_PASSWORD@localhost:27017/jjtextiles_maternity_db?authSource=admin

# Option 2: Legacy / existing database (if you're migrating)
# MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/legacy_db?authSource=admin

# API URL (used by frontend, not backend, but kept for reference)
BASE_URL=https://jjtextiles.com

# Server Configuration
PORT=4000
NODE_ENV=production
VPS_BASE_URL=https://jjtextiles.com

# JWT Configuration - GENERATE NEW SECRET!
# Run: openssl rand -base64 32
JWT_SECRET=YOUR_NEW_SECURE_JWT_SECRET_HERE_GENERATE_WITH_openssl_rand_base64_32

# Admin Credentials - CHANGE THESE!
ADMIN_EMAIL=info.jjtextiles@gmail.com
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD

# PhonePe Configuration
# Option 1: New PhonePe Merchant Account (Recommended)
PHONEPE_ENV=PRODUCTION
# Some parts of the codebase use PHONEPE_ENVIRONMENT (SDK expects UAT/PRODUCTION).
PHONEPE_ENVIRONMENT=PRODUCTION
PHONEPE_MERCHANT_ID=YOUR_NEW_MERCHANT_ID
PHONEPE_API_KEY=YOUR_NEW_API_KEY
# PhonePe Salt Key is REQUIRED for signature generation/verification in multiple modules.
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_REDIRECT_URL=https://jjtextiles.in/payment/phonepe/callback
PHONEPE_CALLBACK_URL=https://jjtextiles.in/api/payment/phonepe/webhook

# Option 2: Reuse Existing PhonePe Account (if same business)
# PHONEPE_ENV=PRODUCTION
# PHONEPE_MERCHANT_ID=SU2507101644104455172815
# PHONEPE_API_KEY=5cb0064a-f4dd-411a-a80c-e8f67479725c
# PHONEPE_SALT_INDEX=1
# PHONEPE_REDIRECT_URL=https://jjtextiles.in/payment/phonepe/callback
# PHONEPE_CALLBACK_URL=https://jjtextiles.in/api/payment/phonepe/webhook

# PhonePe Webhook Authentication - GENERATE NEW CREDENTIALS!
# Run: openssl rand -base64 24 (for password)
PHONEPE_CALLBACK_USERNAME=jjtextiles_webhook
PHONEPE_CALLBACK_PASSWORD=YOUR_NEW_WEBHOOK_PASSWORD_GENERATE_SECURE

# Firebase Admin SDK Configuration
# Option 1: New Firebase Project (Recommended)
GOOGLE_APPLICATION_CREDENTIALS=/var/www/jjtextiles-ecom/backend/jjtextiles-ecom-firebase-adminsdk-XXXXX.json
# Optional (used in development fallback init):
FIREBASE_PROJECT_ID=jjtextiles-ecom

# Option 2: Legacy Firebase Project (if you're migrating)
# GOOGLE_APPLICATION_CREDENTIALS=/var/www/jjtextiles-ecom/backend/legacy-firebase-adminsdk.json

# CORS Configuration
CORS_ORIGIN=https://jjtextiles.com

# Email Configuration
# The code uses TWO email flows:
# - Contact form emails use SMTP_* + EMAIL_USER/EMAIL_PASS (see backend/utils/sendEmail.js + backend/config.js)
# - Invoice emails can use SMTP_* (preferred) OR fall back to Gmail via EMAIL_* (see backend/utils/invoiceGenerator.js)

# Recommended (Gmail SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_NAME=JJTextiles
SMTP_FROM_EMAIL=noreply@jjtextiles.in
SUPPORT_EMAIL=info.jjtextiles@gmail.com
# Optional (invoice sender fallback):
SMTP_USER=info.jjtextiles@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
SMTP_FROM="JJTextiles <noreply@jjtextiles.in>"
# Used by some email flows:
EMAIL_FROM=noreply@jjtextiles.in

# Gmail account/app password (also used as SMTP auth by contact emails):
EMAIL_USER=info.jjtextiles@gmail.com
EMAIL_PASS=YOUR_APP_PASSWORD_HERE

# Option 2: Legacy Email (if you're migrating)
# EMAIL_USER=legacy@example.com
# EMAIL_PASS=YOUR_APP_PASSWORD_HERE

# Frontend URL (for email links, redirects)
FRONTEND_URL=https://jjtextiles.com

# Reservation System Configuration
RESERVATION_ENABLED=true
RESERVATION_EXPIRY_MINUTES=15
RESERVATION_AUTO_EXPIRY=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PRODUCTS_TTL=300
REDIS_CATEGORIES_TTL=3600
REDIS_CART_TTL=3600
REDIS_USER_TTL=86400
REDIS_SESSIONS_TTL=86400
REDIS_STATIC_TTL=7200

# File Upload Configuration
MAX_FILE_SIZE=104857600
# IMPORTANT: Set uploads path to JJTextiles VPS directory
# Example production path (ensure Nginx alias points /images to this base):
#   alias /var/www/jjtextiles/JJTEX/uploads/;
UPLOAD_PATH=/var/www/jjtextiles/JJTEX/uploads

# Image Optimization Configuration
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=800
IMAGE_MAX_HEIGHT=800
IMAGE_VARIANTS=original,webp
SKIP_IMAGE_OPTIMIZATION=false
IMAGE_COMPRESSION_LEVEL=6

# Hero Images Configuration
MAX_DESKTOP=6
MAX_MOBILE=4
MOBILE_THUMB_SIZE=480
DESKTOP_THUMB_SIZE=800
LQIP_SIZE=20
THUMBNAIL_CACHE_SIZE=100

# Maintenance Mode
MAINTENANCE_MODE=false

# Optional: Sentry (backend)
SENTRY_DSN=

