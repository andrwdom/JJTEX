# ========================================
# JJTEXTILES FRONTEND ENVIRONMENT CONFIGURATION
# Copy this file to .env.production and fill in your values
# ========================================

# API URL (Backend endpoint)
NEXT_PUBLIC_API_URL=https://www.jjtextiles.com

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.jjtextiles.com

# Firebase Configuration
# Option 1: New Firebase Project (Recommended)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_NEW_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jjtextiles-ecom.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jjtextiles-ecom
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jjtextiles-ecom.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_NEW_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_NEW_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_NEW_MEASUREMENT_ID

# Option 2: Legacy Firebase Project (if you're migrating)
# NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_LEGACY_FIREBASE_API_KEY
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=legacy.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=legacy
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=legacy.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_LEGACY_SENDER_ID
# NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_LEGACY_APP_ID
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_LEGACY_MEASUREMENT_ID

# Environment
NODE_ENV=production

